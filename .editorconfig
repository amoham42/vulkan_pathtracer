root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,glsl,rgen,rchit,rmiss,rahit,rint,comp}]
max_line_length = 130

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# vendored code and assets keep their own conventions
[{external/**,assets/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
