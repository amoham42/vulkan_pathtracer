#version 460

// One pass of the edge-avoiding À-Trous wavelet filter (Dammertz et al., HPG 2010).
// Run five times with step 1, 2, 4, 8, 16: a 5x5 B3-spline kernel whose taps spread out each pass,
// so five cheap passes cover an 81x81 footprint. Each tap is weighted by how much it differs from
// the centre in colour, normal and depth, so the blur stops at edges and at shadow boundaries.
// The colour tolerance scales with the local variance (as in SVGF, Schied et al. 2017): where the
// image is still noisy it smooths hard, where it has converged it keeps detail. The first pass
// divides out the surface albedo, so the filter smooths lighting, not texture (tonemap.comp
// multiplies it back), and clamps fireflies to their neighbourhood, which a plain edge-stopping
// filter would otherwise preserve as "edges".

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D dst;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D albedoImage;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D normalDepthImage;

layout(push_constant) uniform Post {
    int stepWidth;
    int demodulate;      // 1 on the first pass
    float sigmaColor;    // colour tolerance in local standard deviations
    float normalPower;
    float sigmaDepth;    // relative depth difference
    float exposure;
    int pad0, pad1;
} pc;

const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

vec3 fetch(ivec2 p) {
    vec3 c = imageLoad(src, p).rgb;
    if (pc.demodulate == 1) c /= max(imageLoad(albedoImage, p).rgb, vec3(1e-3));
    return c;
}

void main() {
    const ivec2 size = imageSize(src);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    // statistics of the 8 neighbours, in Reinhard-compressed colour so bright pixels can't dominate
    vec3 mean = vec3(0.0), meanSq = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            const vec3 c = fetch(clamp(p + ivec2(dx, dy), ivec2(0), size - 1));
            const vec3 t = c / (1.0 + c);
            mean += t;
            meanSq += t * t;
        }
    }
    mean /= 8.0;
    const vec3 sd = sqrt(max(meanSq / 8.0 - mean * mean, vec3(0.0)));
    const float variance = dot(sd, sd) / 3.0;

    vec3 cP = fetch(p);
    if (imageLoad(albedoImage, p).a < 0.5) {  // a light: keep its edges crisp
        imageStore(dst, p, vec4(cP, 1.0));
        return;
    }
    vec3 tP = cP / (1.0 + cP);
    if (pc.demodulate == 1) {  // firefly clamp
        tP = clamp(tP, mean - 2.5 * sd, mean + 2.5 * sd);
        tP = min(tP, vec3(0.999));
        cP = tP / (1.0 - tP);
    }
    const float colorScale = pc.sigmaColor * pc.sigmaColor * variance + 1e-4;
    const vec4 ndP = imageLoad(normalDepthImage, p);
    const float lenP = length(ndP.xyz);
    const vec3 nP = lenP > 1e-4 ? ndP.xyz / lenP : vec3(0.0);
    const float zP = ndP.w;

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            const ivec2 q = p + ivec2(dx, dy) * pc.stepWidth;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;

            if (imageLoad(albedoImage, q).a < 0.5) continue;  // never blur light into its surroundings
            const vec3 cQ = (dx == 0 && dy == 0) ? cP : fetch(q);
            const vec3 dt = tP - cQ / (1.0 + cQ);
            const float wColor = exp(-dot(dt, dt) / (3.0 * colorScale));

            const vec4 ndQ = imageLoad(normalDepthImage, q);
            const float lenQ = length(ndQ.xyz);
            const vec3 nQ = lenQ > 1e-4 ? ndQ.xyz / lenQ : vec3(0.0);
            const float wNormal = (lenP > 1e-4 && lenQ > 1e-4) ? pow(max(0.0, dot(nP, nQ)), pc.normalPower) : 1.0;

            const float dz = abs(zP - ndQ.w) / max(zP, 1e-3);
            const float wDepth = exp(-dz / (pc.sigmaDepth * float(pc.stepWidth)));

            const float w = kernel[abs(dx)] * kernel[abs(dy)] * wColor * wNormal * wDepth;
            sum += cQ * w;
            weightSum += w;
        }
    }
    imageStore(dst, p, vec4(weightSum > 0.0 ? sum / weightSum : cP, 1.0));
}
