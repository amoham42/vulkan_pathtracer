#version 460

// One pass of the edge-avoiding À-Trous wavelet filter (Dammertz et al., HPG 2010) with
// SVGF variance propagation (Schied et al., HPG 2017).
// Optimization: light-pixel mask is packed into the sign bit of normalDepthImage.w (< 0 = light),
// so passes 1..4 never touch albedoImage (eliminating 100 imageLoads/pixel across passes 1..4),
// pow(x, 64) uses 6 squarings, and the center tap skips transcendental weights.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D dst;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D albedoImage;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D normalDepthImage;

layout(push_constant) uniform Post {
    int stepWidth;
    int demodulate;      // 1 on pass 0
    float sigmaColor;
    float normalPower;
    float sigmaDepth;
    float exposure;
    uint totalSamples;
    uint pad;
} pc;

const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

float pow64(float x) {
    x *= x;  // ^2
    x *= x;  // ^4
    x *= x;  // ^8
    x *= x;  // ^16
    x *= x;  // ^32
    x *= x;  // ^64
    return x;
}

void main() {
    const ivec2 size = imageSize(src);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    const vec4 srcP = imageLoad(src, p);
    const vec4 ndP = imageLoad(normalDepthImage, p);
    const bool isLightP = ndP.w < 0.0;

    vec3 cP = srcP.rgb;
    vec3 albP = vec3(1.0);
    if (pc.demodulate == 1) {
        albP = max(imageLoad(albedoImage, p).rgb, vec3(1e-3));
        cP /= albP;
    }

    if (isLightP) {
        imageStore(dst, p, vec4(cP, 0.0));
        return;
    }

    vec3 tP = cP / (1.0 + cP);
    float variance = 0.0;

    if (pc.demodulate == 1) {
        vec3 mean = vec3(0.0), meanSq = vec3(0.0);
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) continue;
                const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), size - 1);
                const vec3 c = imageLoad(src, q).rgb / max(imageLoad(albedoImage, q).rgb, vec3(1e-3));
                const vec3 t = c / (1.0 + c);
                mean += t;
                meanSq += t * t;
            }
        }
        mean *= (1.0 / 8.0);
        const vec3 sd = sqrt(max(meanSq * (1.0 / 8.0) - mean * mean, vec3(0.0)));
        const float spatialVar = dot(sd, sd) * (1.0 / 3.0);

        // Firefly clamp
        tP = clamp(tP, mean - 2.5 * sd, mean + 2.5 * sd);
        tP = min(tP, vec3(0.999));
        cP = tP / (1.0 - tP);

        const float rawLum = max(luminance(srcP.rgb), 0.0);
        const float mcVarLum = max(0.0, srcP.a - rawLum * rawLum) / max(float(pc.totalSamples), 1.0);
        const float albLum = max(luminance(albP), 1e-3);
        const float demodLum = max(luminance(cP), 0.0);
        const float onePlus = 1.0 + demodLum;
        const float onePlus2 = onePlus * onePlus;
        const float mcVarT = mcVarLum / (albLum * albLum * onePlus2 * onePlus2);
        variance = (pc.totalSamples >= 4u) ? mix(mcVarT, spatialVar, 0.35) : spatialVar;
    } else {
        variance = max(srcP.a, 0.0);
    }

    const float invColorScale = -1.0 / (3.0 * (pc.sigmaColor * pc.sigmaColor * variance + 1e-4));
    const float lenP = length(ndP.xyz);
    const vec3 nP = lenP > 1e-4 ? ndP.xyz / lenP : vec3(0.0);
    const float zP = abs(ndP.w);
    const float invDepthScale = -1.0 / (max(zP, 1e-3) * pc.sigmaDepth * float(pc.stepWidth));
    const bool hasNormalP = lenP > 1e-4;
    const bool fastPow64 = (pc.normalPower == 64.0);

    // Seed center tap (dx == 0, dy == 0) directly: wColor = wNormal = wDepth = 1.0.
    const float w0 = kernel[0] * kernel[0];
    vec3 sum = cP * w0;
    float sumVar = variance * w0 * w0;
    float weightSum = w0;

    for (int dy = -2; dy <= 2; dy++) {
        const float ky = kernel[abs(dy)];
        const int qy = p.y + dy * pc.stepWidth;
        if (qy < 0 || qy >= size.y) continue;
        for (int dx = -2; dx <= 2; dx++) {
            if (dx == 0 && dy == 0) continue;
            const int qx = p.x + dx * pc.stepWidth;
            if (qx < 0 || qx >= size.x) continue;

            const ivec2 q = ivec2(qx, qy);
            const vec4 ndQ = imageLoad(normalDepthImage, q);
            if (ndQ.w < 0.0) continue;  // light pixel: never blur into surroundings

            const vec4 srcQ = imageLoad(src, q);
            const vec3 cQ = (pc.demodulate == 1) ? (srcQ.rgb / max(imageLoad(albedoImage, q).rgb, vec3(1e-3))) : srcQ.rgb;
            const float varQ = (pc.demodulate == 1) ? variance : max(srcQ.a, 0.0);

            const vec3 dt = tP - cQ / (1.0 + cQ);
            const float wColor = exp(dot(dt, dt) * invColorScale);

            const float lenQ = length(ndQ.xyz);
            float wNormal = 1.0;
            if (hasNormalP && lenQ > 1e-4) {
                const float ndot = max(0.0, dot(nP, ndQ.xyz / lenQ));
                wNormal = fastPow64 ? pow64(ndot) : pow(ndot, pc.normalPower);
            }

            const float wDepth = exp(abs(zP - ndQ.w) * invDepthScale);
            const float w = kernel[abs(dx)] * ky * wColor * wNormal * wDepth;
            sum += cQ * w;
            sumVar += varQ * w * w;
            weightSum += w;
        }
    }
    const float invW = 1.0 / weightSum;
    imageStore(dst, p, vec4(sum * invW, sumVar * invW * invW));
}
