#version 460

// One pass of the edge-avoiding À-Trous wavelet filter (Dammertz et al., HPG 2010) with
// SVGF variance propagation (Schied et al., HPG 2017).
// Pass 0 demodulates albedo, clamps fireflies using a 3x3 neighbourhood, and seeds per-pixel
// variance from the accumulated second moment (accumImage.a). Passes 1..4 read the propagated
// variance directly from src.a, avoiding redundant 3x3 neighbourhood fetches while preserving
// sharper shadow boundaries.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D dst;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D albedoImage;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D normalDepthImage;

layout(push_constant) uniform Post {
    int stepWidth;
    int demodulate;      // 1 on the first pass
    float sigmaColor;    // colour tolerance in local standard deviations
    float normalPower;
    float sigmaDepth;    // relative depth difference
    float exposure;
    uint totalSamples;
    uint pad;
} pc;

const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 fetchDemod(ivec2 p, vec3 alb) {
    return imageLoad(src, p).rgb / max(alb, vec3(1e-3));
}

void main() {
    const ivec2 size = imageSize(src);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    const vec4 srcP = imageLoad(src, p);
    const vec4 albP = imageLoad(albedoImage, p);
    vec3 cP = (pc.demodulate == 1) ? (srcP.rgb / max(albP.rgb, vec3(1e-3))) : srcP.rgb;

    if (albP.a < 0.5) {  // a light: keep its edges crisp
        imageStore(dst, p, vec4(cP, 0.0));
        return;
    }

    vec3 tP = cP / (1.0 + cP);
    float variance = 0.0;

    if (pc.demodulate == 1) {
        // 3x3 neighbourhood statistics in Reinhard-compressed space for firefly clamping + fallback variance
        vec3 mean = vec3(0.0), meanSq = vec3(0.0);
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) continue;
                const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), size - 1);
                const vec3 c = fetchDemod(q, imageLoad(albedoImage, q).rgb);
                const vec3 t = c / (1.0 + c);
                mean += t;
                meanSq += t * t;
            }
        }
        mean /= 8.0;
        const vec3 sd = sqrt(max(meanSq / 8.0 - mean * mean, vec3(0.0)));
        const float spatialVar = dot(sd, sd) / 3.0;

        // Firefly clamp
        tP = clamp(tP, mean - 2.5 * sd, mean + 2.5 * sd);
        tP = min(tP, vec3(0.999));
        cP = tP / (1.0 - tP);

        // Combine true per-pixel Monte Carlo variance (delta method on Reinhard t = L/(1+L)) with spatial estimate
        const float rawLum = max(luminance(srcP.rgb), 0.0);
        const float mcVarLum = max(0.0, srcP.a - rawLum * rawLum) / max(float(pc.totalSamples), 1.0);
        const float albLum = max(luminance(albP.rgb), 1e-3);
        const float demodLum = max(luminance(cP), 0.0);
        const float demodScale = 1.0 / (albLum * albLum * pow(1.0 + demodLum, 4.0));
        const float mcVarT = mcVarLum * demodScale;
        variance = (pc.totalSamples >= 4u) ? mix(mcVarT, spatialVar, 0.35) : spatialVar;
    } else {
        variance = max(srcP.a, 0.0);
    }

    const float colorScale = pc.sigmaColor * pc.sigmaColor * variance + 1e-4;
    const vec4 ndP = imageLoad(normalDepthImage, p);
    const float lenP = length(ndP.xyz);
    const vec3 nP = lenP > 1e-4 ? ndP.xyz / lenP : vec3(0.0);
    const float zP = ndP.w;

    vec3 sum = vec3(0.0);
    float sumVar = 0.0;
    float weightSum = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            const ivec2 q = p + ivec2(dx, dy) * pc.stepWidth;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;

            const vec4 albQ = imageLoad(albedoImage, q);
            if (albQ.a < 0.5) continue;  // never blur light into its surroundings

            vec3 cQ;
            float varQ;
            if (dx == 0 && dy == 0) {
                cQ = cP;
                varQ = variance;
            } else {
                const vec4 srcQ = imageLoad(src, q);
                cQ = (pc.demodulate == 1) ? (srcQ.rgb / max(albQ.rgb, vec3(1e-3))) : srcQ.rgb;
                varQ = (pc.demodulate == 1) ? variance : max(srcQ.a, 0.0);
            }

            const vec3 dt = tP - cQ / (1.0 + cQ);
            const float wColor = exp(-dot(dt, dt) / (3.0 * colorScale));

            const vec4 ndQ = imageLoad(normalDepthImage, q);
            const float lenQ = length(ndQ.xyz);
            const vec3 nQ = lenQ > 1e-4 ? ndQ.xyz / lenQ : vec3(0.0);
            const float wNormal = (lenP > 1e-4 && lenQ > 1e-4) ? pow(max(0.0, dot(nP, nQ)), pc.normalPower) : 1.0;

            const float dz = abs(zP - ndQ.w) / max(zP, 1e-3);
            const float wDepth = exp(-dz / (pc.sigmaDepth * float(pc.stepWidth)));

            const float w = kernel[abs(dx)] * kernel[abs(dy)] * wColor * wNormal * wDepth;
            sum += cQ * w;
            sumVar += varQ * w * w;
            weightSum += w;
        }
    }
    const vec3 outColor = weightSum > 0.0 ? sum / weightSum : cP;
    const float outVar = weightSum > 0.0 ? sumVar / (weightSum * weightSum) : variance;
    imageStore(dst, p, vec4(outColor, outVar));
}
